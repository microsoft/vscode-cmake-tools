{
	"$schema" : "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.4.json",
	"runs" :
	[
		{
			"results" :
			[
				{
					"level" : "warning",
					"locations" :
					[
						{
							"physicalLocation" :
							{
								"artifactLocation" :
								{
									"uri" : "CMakeLists.txt"
								},
								"region" :
								{
									"startLine" : 5
								}
							}
						}
					],
					"message" :
					{
						"text" : "a plain warning"
					},
					"ruleId" : "CMake.Warning",
					"ruleIndex" : 0
				},
				{
					"level" : "error",
					"locations" :
					[
						{
							"physicalLocation" :
							{
								"artifactLocation" :
								{
									"uri" : "sub.cmake"
								},
								"region" :
								{
									"startLine" : 2
								}
							}
						}
					],
					"message" :
					{
						"text" : "an error from a subdirectory"
					},
					"ruleId" : "CMake.FatalError",
					"ruleIndex" : 1
				}
			],
			"tool" :
			{
				"driver" :
				{
					"name" : "CMake",
					"rules" :
					[
						{
							"id" : "CMake.Warning",
							"messageStrings" :
							{
								"default" :
								{
									"text" : "CMake Warning: {0}"
								}
							},
							"name" : "CMake Warning"
						},
						{
							"id" : "CMake.FatalError",
							"messageStrings" :
							{
								"default" :
								{
									"text" : "CMake Error: {0}"
								}
							},
							"name" : "CMake Error"
						}
					],
					"version" : "4.4.0"
				}
			}
		}
	],
	"version" : "2.1.0"
}
